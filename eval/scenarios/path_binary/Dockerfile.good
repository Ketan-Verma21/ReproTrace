FROM reprotrace-eval-base
COPY app.py /app/app.py
COPY run.sh /scenario/run.sh
# COPY keeps the host file mode; the scenario runs as a non-root user.
RUN chmod 644 /app/app.py /scenario/run.sh
ENV PATH=/opt/tools/bin:/usr/local/bin:/usr/bin:/bin
RUN mkdir -p /opt/tools/bin && printf "#!/bin/sh\\necho hello\\n" > /opt/tools/bin/greet && chmod 755 /opt/tools/bin/greet
