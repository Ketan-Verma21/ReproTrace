FROM reprotrace-eval-base
COPY app.py /app/app.py
COPY run.sh /scenario/run.sh
# COPY keeps the host file mode; the scenario runs as a non-root user.
RUN chmod 644 /app/app.py /scenario/run.sh
ENV PYTHONPATH=/opt/deps
# The planted cause: an older version of the dependency is installed.
RUN mkdir -p /opt/deps/mylib /opt/deps/mylib-1.9.0.dist-info \
    && printf '__version__ = "1.9.0"\n' > /opt/deps/mylib/__init__.py \
    && printf 'Metadata-Version: 2.1\nName: mylib\nVersion: 1.9.0\n' > /opt/deps/mylib-1.9.0.dist-info/METADATA
